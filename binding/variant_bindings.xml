<?xml version="1.0"?>
<typesystem package="variant_binding">

    <!-- ==================================================================
         文件分区（生产部署只取 CORE 段）：
           [CORE]  vt::Variant / vt::VariantMap / vt::VariantList 的转换规则
                   + 它们对应的 C++ 文件（binding/core/）。
                   生产部署清单见 binding/core/README.md。
           [DEMO]  示例类型与示例函数（DemoNode/DemoColor/SharedNode/
                   PluginBase/echo*/holdPayload...），不要带进生产。

         设计（见 docs/真实签名迁移计划.md）：
         - 函数签名直接写 vt::Variant / vt::VariantMap / 标准容器；
         - Python 侧看到的就是原生 dict/list/标量，不出现 PyObject 门面；
         - 容器不逐个注册：shiboken 内置 vector/unordered_map/VariantList
           转换器负责容器层，元素层复用 Variant 规则，天然递归。
         ================================================================== -->

    <!-- ============================== CORE BEGIN ============================== -->

    <!-- ====== vt::Variant 作为 primitive-type ======
         target-lang-api-name="PyObject" 表示 Python 侧是任意原生对象。
         递归在 vpy::toPython/fromPython 内部完成；这里只暴露转换入口。 -->
    <primitive-type name="vt::Variant" target-lang-api-name="PyObject">
        <include file-name="vt/variant.h" location="local"/>
        <include file-name="variant_python.h" location="local"/>
        <conversion-rule>
            <native-to-target file="core/glue/variant_convert.cpp" snippet="variant-to-python"/>
            <target-to-native>
                <add-conversion type="Py_None" check="%in == Py_None"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="PyBool" check="PyBool_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="PyLong" check="PyLong_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="PyFloat" check="PyFloat_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="PyUnicode" check="PyUnicode_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="PyList" check="PyList_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="PyTuple" check="PyTuple_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="PyDict" check="PyDict_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <add-conversion type="SbkObject" check="vpy::isRegisteredObject(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
                <!-- 兜底：任何对象都进入转换函数，由 fromPython 给出明确的
                     TypeError。没有这一条时，未匹配的类型会让 shiboken 走
                     returnWrongArguments，而它解析不了 "vt.Variant" 签名，
                     会直接 fatal（seterror_argument did not receive a result）。 -->
                <add-conversion type="PyObject" check="true"
                                file="core/glue/variant_convert.cpp" snippet="variant-from-python"/>
            </target-to-native>
        </conversion-rule>
    </primitive-type>

    <!-- ====== vt::VariantMap 作为 primitive-type ======
         不手写逐元素递归：内部委托给 shiboken 内置的
         std::unordered_map<std::string, vt::Variant> 转换器，
         元素再回调 vt::Variant 的转换规则。 -->
    <primitive-type name="vt::VariantMap" target-lang-api-name="PyObject">
        <include file-name="vt/variant_map.h" location="local"/>
        <conversion-rule>
            <native-to-target file="core/glue/variant_convert.cpp" snippet="variantmap-to-python"/>
            <target-to-native>
                <add-conversion type="PyDict" check="PyDict_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variantmap-from-python"/>
                <!-- 兜底：同 vt::Variant，避免重载解析失败时 shiboken fatal。 -->
                <add-conversion type="PyObject" check="true"
                                file="core/glue/variant_convert.cpp" snippet="variantmap-from-python-catchall"/>
            </target-to-native>
        </conversion-rule>
    </primitive-type>

    <!-- ====== vt::VariantList 作为 primitive-type ======
         同 VariantMap：委托给 shiboken 内置的 std::vector<vt::Variant> 转换器。
         list 与 tuple 都接受（tuple 读入后变 list）。 -->
    <primitive-type name="vt::VariantList" target-lang-api-name="PyObject">
        <include file-name="vt/variant_list.h" location="local"/>
        <conversion-rule>
            <native-to-target file="core/glue/variant_convert.cpp" snippet="variantlist-to-python"/>
            <target-to-native>
                <add-conversion type="PyList" check="PyList_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variantlist-from-python"/>
                <add-conversion type="PyTuple" check="PyTuple_Check(%in)"
                                file="core/glue/variant_convert.cpp" snippet="variantlist-from-python"/>
                <add-conversion type="PyObject" check="true"
                                file="core/glue/variant_convert.cpp" snippet="variantlist-from-python-catchall"/>
            </target-to-native>
        </conversion-rule>
    </primitive-type>

    <!-- =============================== CORE END =============================== -->

    <!-- ============================== DEMO BEGIN ============================== -->

    <!-- ====== 全局函数（真实 C++ 签名） ====== -->

    <add-function signature="initTypes()">
        <inject-code class="target" position="beginning">
            PyObject *pyResult{};
            bool cppResult = vpy::registerDemoTypes();
            pyResult = Shiboken::Conversions::copyToPython(
                Shiboken::Conversions::PrimitiveTypeConverter&lt;bool&gt;(), &amp;cppResult);
            return pyResult;
        </inject-code>
    </add-function>

    <add-function signature="makeSample()">
        <inject-code class="target" position="beginning">
            auto cppResult = makeSample();
            return %CONVERTTOPYTHON[vt::Variant](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="makeBuiltinSample()">
        <inject-code class="target" position="beginning">
            auto cppResult = makeBuiltinSample();
            return %CONVERTTOPYTHON[vt::Variant](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="makeNestedSample()">
        <inject-code class="target" position="beginning">
            auto cppResult = makeNestedSample();
            return %CONVERTTOPYTHON[vt::Variant](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="makeNodeKeySample()">
        <inject-code class="target" position="beginning">
            auto cppResult = makeNodeKeySample();
            return %CONVERTTOPYTHON[vt::Variant](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="makeUnhashableKeySample()">
        <inject-code class="target" position="beginning">
            auto cppResult = makeUnhashableKeySample();
            return %CONVERTTOPYTHON[vt::Variant](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="echo(const vt::Variant&amp;)">
        <inject-code class="target" position="beginning">
            auto cppResult = echo(cppArg0);
            return %CONVERTTOPYTHON[vt::Variant](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="echoMap(const vt::VariantMap&amp;)">
        <inject-code class="target" position="beginning">
            auto cppResult = echoMap(cppArg0);
            return %CONVERTTOPYTHON[vt::VariantMap](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="echoList(const vt::VariantList&amp;)">
        <inject-code class="target" position="beginning">
            auto cppResult = echoList(cppArg0);
            return %CONVERTTOPYTHON[vt::VariantList](cppResult);
        </inject-code>
    </add-function>

    <!-- 容器没有单独注册：依赖 shiboken 内置的 vector / unordered_map 转换器，
         元素转换复用上面的 vt::Variant 规则。 -->
    <add-function signature="echoVector(const std::vector&lt;vt::Variant&gt;&amp;)">
        <inject-code class="target" position="beginning">
            auto cppResult = echoVector(cppArg0);
            return %CONVERTTOPYTHON[std::vector&lt;vt::Variant&gt;](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="echoUnorderedMap(const std::unordered_map&lt;std::string, vt::Variant&gt;&amp;)">
        <inject-code class="target" position="beginning">
            auto cppResult = echoUnorderedMap(cppArg0);
            return %CONVERTTOPYTHON[std::unordered_map&lt;std::string, vt::Variant&gt;](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="sumInts(const std::vector&lt;int&gt;&amp;)">
        <inject-code class="target" position="beginning">
            const int cppResult = sumInts(cppArg0);
            return PyLong_FromLong(cppResult);
        </inject-code>
    </add-function>

    <add-function signature="intMapSize(const std::unordered_map&lt;int, int&gt;&amp;)">
        <inject-code class="target" position="beginning">
            const int cppResult = intMapSize(cppArg0);
            return PyLong_FromLong(cppResult);
        </inject-code>
    </add-function>

    <add-function signature="describeValue(const vt::Variant&amp;)">
        <inject-code class="target" position="beginning">
            const std::string text = describeValue(cppArg0);
            return PyUnicode_DecodeUTF8(text.data(),
                                        static_cast&lt;Py_ssize_t&gt;(text.size()), "strict");
        </inject-code>
    </add-function>

    <!-- 共享所有权：Python 侧是真正的 SharedNode（带 capsule），不是句柄类型。 -->
    <add-function signature="makeSharedNode(int, const std::string&amp;)">
        <inject-code class="target" position="beginning">
            return makeSharedNodeToPython(cppArg0, cppArg1);
        </inject-code>
    </add-function>

    <add-function signature="borrowSharedNode(int, const std::string&amp;)">
        <inject-code class="target" position="beginning">
            return borrowSharedNodeToPython(cppArg0, cppArg1);
        </inject-code>
    </add-function>

    <!-- 测试持有：替代已删除的 PyDocument，验证跨语言生命周期。 -->
    <add-function signature="holdPayload(const vt::VariantMap&amp;)">
        <inject-code class="target" position="beginning">
            holdPayload(cppArg0);
            Py_RETURN_NONE;
        </inject-code>
    </add-function>

    <add-function signature="heldPayload()">
        <inject-code class="target" position="beginning">
            auto cppResult = heldPayload();
            return %CONVERTTOPYTHON[vt::VariantMap](cppResult);
        </inject-code>
    </add-function>

    <add-function signature="releasePayload()">
        <inject-code class="target" position="beginning">
            releasePayload();
            Py_RETURN_NONE;
        </inject-code>
    </add-function>

    <!-- ====== 注册类型的演示：object-type 保持对象身份，value-type 按值拷贝 ====== -->
    <object-type name="DemoNode"/>
    <object-type name="SharedNode"/>
    <value-type name="DemoColor"/>

    <!-- 多态基类：Python 可继承并重写 compute()/describe()/evaluate()/transform()，
         shiboken 为多态类生成 wrapper，C++ 侧虚调用会转发到 Python。 -->
    <object-type name="PluginBase"/>

    <!-- 虚函数 evaluate() 的输入/输出：值类型，Python <-> C++ 按值拷贝往返。 -->
    <value-type name="PluginRequest"/>
    <value-type name="PluginResult"/>

    <!-- =============================== DEMO END =============================== -->

</typesystem>
